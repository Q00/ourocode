diff --git a/src/terminal/PageBudget.zig b/src/terminal/PageBudget.zig
new file mode 100644
index 0000000..5104f2b
--- /dev/null
+++ b/src/terminal/PageBudget.zig
@@ -0,0 +1,529 @@
+//! Shared hard accounting for terminal page backing mappings.
+//!
+//! Charges are rounded exactly as the native page allocator rounds mappings,
+//! using the runtime OS page size. Decommitted mappings remain charged until
+//! the allocator actually frees them; this is not a physical RSS cap.
+const PageBudget = @This();
+
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+owner: Allocator,
+child: Allocator,
+limit: usize,
+used: std.atomic.Value(usize) = .init(0),
+peak: std.atomic.Value(usize) = .init(0),
+denials: std.atomic.Value(usize) = .init(0),
+child_failures: std.atomic.Value(usize) = .init(0),
+refs: std.atomic.Value(usize) = .init(1),
+
+pub const Failure = enum(u8) {
+    none,
+    budget_exhausted,
+    child_out_of_memory,
+    invalid_size,
+};
+
+pub const FailureState = struct {
+    epoch: usize,
+    last: Failure,
+};
+
+pub const Stats = struct {
+    limit: usize,
+    used: usize,
+    peak: usize,
+    denials: usize,
+    child_failures: usize,
+};
+
+/// Refcounted terminal-local failure state shared by every PageList adapter
+/// derived from one terminal. A single packed atomic makes the reported cause
+/// correspond to the latest epoch even when allocations fail concurrently.
+pub const FailureSink = struct {
+    owner: Allocator,
+    refs: std.atomic.Value(usize) = .init(1),
+    state: std.atomic.Value(usize) = .init(0),
+
+    const failure_bits = 2;
+    const failure_mask = (1 << failure_bits) - 1;
+
+    pub fn create(owner: Allocator) Allocator.Error!*FailureSink {
+        const self = try owner.create(FailureSink);
+        self.* = .{ .owner = owner };
+        return self;
+    }
+
+    pub fn retain(self: *FailureSink) *FailureSink {
+        const previous = self.refs.fetchAdd(1, .monotonic);
+        std.debug.assert(previous > 0 and previous < std.math.maxInt(usize));
+        return self;
+    }
+
+    pub fn releaseRef(self: *FailureSink) void {
+        const previous = self.refs.fetchSub(1, .acq_rel);
+        std.debug.assert(previous > 0);
+        if (previous == 1) self.owner.destroy(self);
+    }
+
+    pub fn failureState(self: *const FailureSink) FailureState {
+        const encoded = self.state.load(.acquire);
+        return .{
+            .epoch = encoded >> failure_bits,
+            .last = @enumFromInt(encoded & failure_mask),
+        };
+    }
+
+    fn record(self: *FailureSink, failure: Failure) void {
+        std.debug.assert(failure != .none);
+        var current = self.state.load(.monotonic);
+        while (true) {
+            const epoch = current >> failure_bits;
+            std.debug.assert(epoch < (std.math.maxInt(usize) >> failure_bits));
+            const next = ((epoch + 1) << failure_bits) | @intFromEnum(failure);
+            current = self.state.cmpxchgWeak(
+                current,
+                next,
+                .acq_rel,
+                .monotonic,
+            ) orelse return;
+        }
+    }
+};
+
+/// A terminal-local allocator context. Its epoch changes only for failures
+/// caused by allocations routed through this adapter, so another terminal
+/// sharing the same PageBudget cannot create a false failure observation.
+pub const Adapter = struct {
+    owner: Allocator,
+    budget: *PageBudget,
+    failure_sink: *FailureSink,
+
+    pub fn create(
+        owner: Allocator,
+        budget: *PageBudget,
+        failure_sink: ?*FailureSink,
+    ) Allocator.Error!*Adapter {
+        const sink = if (failure_sink) |value|
+            value.retain()
+        else
+            try FailureSink.create(owner);
+        errdefer sink.releaseRef();
+        const self = try owner.create(Adapter);
+        self.* = .{
+            .owner = owner,
+            .budget = budget.retain(),
+            .failure_sink = sink,
+        };
+        return self;
+    }
+
+    pub fn destroy(self: *Adapter) void {
+        const owner = self.owner;
+        self.budget.releaseRef();
+        self.failure_sink.releaseRef();
+        owner.destroy(self);
+    }
+
+    pub fn allocator(self: *Adapter) Allocator {
+        return .{ .ptr = self, .vtable = &adapter_vtable };
+    }
+
+    pub fn failureState(self: *const Adapter) FailureState {
+        return self.failure_sink.failureState();
+    }
+
+    fn record(self: *Adapter, failure: Failure) void {
+        self.failure_sink.record(failure);
+    }
+};
+
+pub fn create(owner: Allocator, child: Allocator, limit: usize) Allocator.Error!*PageBudget {
+    const self = try owner.create(PageBudget);
+    self.* = .{ .owner = owner, .child = child, .limit = limit };
+    return self;
+}
+
+pub fn retain(self: *PageBudget) *PageBudget {
+    const previous = self.refs.fetchAdd(1, .monotonic);
+    std.debug.assert(previous > 0 and previous < std.math.maxInt(usize));
+    return self;
+}
+
+pub fn releaseRef(self: *PageBudget) void {
+    const previous = self.refs.fetchSub(1, .acq_rel);
+    std.debug.assert(previous > 0);
+    if (previous == 1) self.owner.destroy(self);
+}
+
+pub fn stats(self: *const PageBudget) Stats {
+    return .{
+        .limit = self.limit,
+        .used = self.used.load(.acquire),
+        .peak = self.peak.load(.acquire),
+        .denials = self.denials.load(.acquire),
+        .child_failures = self.child_failures.load(.acquire),
+    };
+}
+
+/// Primarily for focused tests. Production PageLists use an Adapter so
+/// failures are attributable to one terminal rather than the shared budget.
+pub fn allocator(self: *PageBudget) Allocator {
+    return .{ .ptr = self, .vtable = &budget_vtable };
+}
+
+fn roundedBytes(len: usize) ?usize {
+    const page_size = std.heap.pageSize();
+    const mask = page_size - 1;
+    const added = std.math.add(usize, len, mask) catch return null;
+    return added & ~mask;
+}
+
+fn reserve(self: *PageBudget, bytes: usize) bool {
+    var current = self.used.load(.monotonic);
+    while (true) {
+        const next = std.math.add(usize, current, bytes) catch return false;
+        if (next > self.limit) return false;
+        current = self.used.cmpxchgWeak(current, next, .acq_rel, .monotonic) orelse {
+            self.raisePeak(next);
+            return true;
+        };
+    }
+}
+
+fn release(self: *PageBudget, bytes: usize) void {
+    const previous = self.used.fetchSub(bytes, .acq_rel);
+    std.debug.assert(previous >= bytes);
+}
+
+fn raisePeak(self: *PageBudget, candidate: usize) void {
+    var current = self.peak.load(.monotonic);
+    while (candidate > current) {
+        current = self.peak.cmpxchgWeak(
+            current,
+            candidate,
+            .monotonic,
+            .monotonic,
+        ) orelse return;
+    }
+}
+
+fn recordGlobal(self: *PageBudget, failure: Failure) void {
+    switch (failure) {
+        .budget_exhausted, .invalid_size => _ = self.denials.fetchAdd(1, .monotonic),
+        .child_out_of_memory => _ = self.child_failures.fetchAdd(1, .monotonic),
+        .none => unreachable,
+    }
+}
+
+fn allocation(
+    self: *PageBudget,
+    adapter: ?*Adapter,
+    len: usize,
+    alignment: std.mem.Alignment,
+    return_address: usize,
+) ?[*]u8 {
+    const charge = roundedBytes(len) orelse {
+        self.recordFailure(adapter, .invalid_size);
+        return null;
+    };
+    if (!self.reserve(charge)) {
+        self.recordFailure(adapter, .budget_exhausted);
+        return null;
+    }
+    return self.child.rawAlloc(len, alignment, return_address) orelse {
+        self.release(charge);
+        self.recordFailure(adapter, .child_out_of_memory);
+        return null;
+    };
+}
+
+fn resizing(
+    self: *PageBudget,
+    adapter: ?*Adapter,
+    memory: []u8,
+    alignment: std.mem.Alignment,
+    new_len: usize,
+    return_address: usize,
+) bool {
+    const old_charge = roundedBytes(memory.len) orelse unreachable;
+    const new_charge = roundedBytes(new_len) orelse {
+        self.recordFailure(adapter, .invalid_size);
+        return false;
+    };
+    const increase = new_charge -| old_charge;
+    if (increase > 0 and !self.reserve(increase)) {
+        self.recordFailure(adapter, .budget_exhausted);
+        return false;
+    }
+    if (!self.child.rawResize(memory, alignment, new_len, return_address)) {
+        if (increase > 0) self.release(increase);
+        // `false` is an allocator capability result, not an OOM result. The
+        // caller may fall back to allocating and copying a replacement. Any
+        // real child OOM is observed by allocation() during that fallback.
+        return false;
+    }
+    if (old_charge > new_charge) self.release(old_charge - new_charge);
+    return true;
+}
+
+fn remapping(
+    self: *PageBudget,
+    adapter: ?*Adapter,
+    memory: []u8,
+    alignment: std.mem.Alignment,
+    new_len: usize,
+    return_address: usize,
+) ?[*]u8 {
+    const old_charge = roundedBytes(memory.len) orelse unreachable;
+    const new_charge = roundedBytes(new_len) orelse {
+        self.recordFailure(adapter, .invalid_size);
+        return null;
+    };
+    const increase = new_charge -| old_charge;
+    if (increase > 0 and !self.reserve(increase)) {
+        self.recordFailure(adapter, .budget_exhausted);
+        return null;
+    }
+    const result = self.child.rawRemap(
+        memory,
+        alignment,
+        new_len,
+        return_address,
+    ) orelse {
+        if (increase > 0) self.release(increase);
+        // `null` asks Allocator.realloc to allocate/copy/free. It does not
+        // mean that the child allocator exhausted memory. Keep the terminal
+        // failure epoch unchanged unless the fallback rawAlloc really fails.
+        return null;
+    };
+    if (old_charge > new_charge) self.release(old_charge - new_charge);
+    return result;
+}
+
+fn freeing(
+    self: *PageBudget,
+    memory: []u8,
+    alignment: std.mem.Alignment,
+    return_address: usize,
+) void {
+    const charge = roundedBytes(memory.len) orelse unreachable;
+    self.child.rawFree(memory, alignment, return_address);
+    self.release(charge);
+}
+
+fn recordFailure(self: *PageBudget, adapter: ?*Adapter, failure: Failure) void {
+    self.recordGlobal(failure);
+    if (adapter) |value| value.record(failure);
+}
+
+const budget_vtable: Allocator.VTable = .{
+    .alloc = directAlloc,
+    .resize = directResize,
+    .remap = directRemap,
+    .free = directFree,
+};
+const adapter_vtable: Allocator.VTable = .{
+    .alloc = adapterAlloc,
+    .resize = adapterResize,
+    .remap = adapterRemap,
+    .free = adapterFree,
+};
+
+fn directAlloc(ctx: *anyopaque, len: usize, alignment: std.mem.Alignment, ra: usize) ?[*]u8 {
+    const self: *PageBudget = @ptrCast(@alignCast(ctx));
+    return self.allocation(null, len, alignment, ra);
+}
+fn directResize(ctx: *anyopaque, memory: []u8, alignment: std.mem.Alignment, new_len: usize, ra: usize) bool {
+    const self: *PageBudget = @ptrCast(@alignCast(ctx));
+    return self.resizing(null, memory, alignment, new_len, ra);
+}
+fn directRemap(ctx: *anyopaque, memory: []u8, alignment: std.mem.Alignment, new_len: usize, ra: usize) ?[*]u8 {
+    const self: *PageBudget = @ptrCast(@alignCast(ctx));
+    return self.remapping(null, memory, alignment, new_len, ra);
+}
+fn directFree(ctx: *anyopaque, memory: []u8, alignment: std.mem.Alignment, ra: usize) void {
+    const self: *PageBudget = @ptrCast(@alignCast(ctx));
+    self.freeing(memory, alignment, ra);
+}
+fn adapterAlloc(ctx: *anyopaque, len: usize, alignment: std.mem.Alignment, ra: usize) ?[*]u8 {
+    const adapter: *Adapter = @ptrCast(@alignCast(ctx));
+    return adapter.budget.allocation(adapter, len, alignment, ra);
+}
+fn adapterResize(ctx: *anyopaque, memory: []u8, alignment: std.mem.Alignment, new_len: usize, ra: usize) bool {
+    const adapter: *Adapter = @ptrCast(@alignCast(ctx));
+    return adapter.budget.resizing(adapter, memory, alignment, new_len, ra);
+}
+fn adapterRemap(ctx: *anyopaque, memory: []u8, alignment: std.mem.Alignment, new_len: usize, ra: usize) ?[*]u8 {
+    const adapter: *Adapter = @ptrCast(@alignCast(ctx));
+    return adapter.budget.remapping(adapter, memory, alignment, new_len, ra);
+}
+fn adapterFree(ctx: *anyopaque, memory: []u8, alignment: std.mem.Alignment, ra: usize) void {
+    const adapter: *Adapter = @ptrCast(@alignCast(ctx));
+    adapter.budget.freeing(memory, alignment, ra);
+}
+
+test "runtime page rounded exact threshold" {
+    const testing = std.testing;
+    const page_size = std.heap.pageSize();
+    const budget = try create(testing.allocator, testing.allocator, page_size);
+    defer budget.releaseRef();
+    const bytes = try budget.allocator().alloc(u8, 1);
+    try testing.expectEqual(page_size, budget.stats().used);
+    try testing.expectError(error.OutOfMemory, budget.allocator().alloc(u8, 1));
+    budget.allocator().free(bytes);
+    try testing.expectEqual(@as(usize, 0), budget.stats().used);
+}
+
+test "child failure rolls reservation back and is adapter local" {
+    const testing = std.testing;
+    var failing = testing.FailingAllocator.init(testing.allocator, .{ .fail_index = 0 });
+    const budget = try create(testing.allocator, failing.allocator(), std.heap.pageSize());
+    defer budget.releaseRef();
+    const adapter = try Adapter.create(testing.allocator, budget, null);
+    defer adapter.destroy();
+
+    try testing.expectError(error.OutOfMemory, adapter.allocator().alloc(u8, 1));
+    try testing.expectEqual(@as(usize, 0), budget.stats().used);
+    try testing.expectEqual(Failure.child_out_of_memory, adapter.failureState().last);
+    try testing.expectEqual(@as(usize, 1), adapter.failureState().epoch);
+    try testing.expectEqual(@as(usize, 1), budget.stats().child_failures);
+}
+
+test "resize and remap fallback do not report child out of memory" {
+    const testing = std.testing;
+    const page_size = std.heap.pageSize();
+    var moving = testing.FailingAllocator.init(testing.allocator, .{
+        .resize_fail_index = 0,
+    });
+    const budget = try create(testing.allocator, moving.allocator(), page_size * 8);
+    defer budget.releaseRef();
+    const adapter = try Adapter.create(testing.allocator, budget, null);
+    defer adapter.destroy();
+    const alloc = adapter.allocator();
+
+    var bytes = try alloc.alloc(u8, 1);
+    bytes[0] = 0xa5;
+    try testing.expect(!alloc.resize(bytes, page_size + 1));
+    try testing.expectEqual(@as(usize, 0), adapter.failureState().epoch);
+    try testing.expectEqual(page_size, budget.stats().used);
+
+    bytes = try alloc.realloc(bytes, page_size + 1);
+    try testing.expectEqual(@as(u8, 0xa5), bytes[0]);
+    try testing.expectEqual(@as(usize, 0), adapter.failureState().epoch);
+    try testing.expectEqual(@as(usize, 0), budget.stats().child_failures);
+    try testing.expectEqual(page_size * 2, budget.stats().used);
+    alloc.free(bytes);
+    try testing.expectEqual(@as(usize, 0), budget.stats().used);
+}
+
+test "real realloc fallback child failure is reported and preserves old charge" {
+    const testing = std.testing;
+    const page_size = std.heap.pageSize();
+    var failing = testing.FailingAllocator.init(testing.allocator, .{
+        .fail_index = 1,
+        .resize_fail_index = 0,
+    });
+    const budget = try create(testing.allocator, failing.allocator(), page_size * 8);
+    defer budget.releaseRef();
+    const adapter = try Adapter.create(testing.allocator, budget, null);
+    defer adapter.destroy();
+    const alloc = adapter.allocator();
+
+    const bytes = try alloc.alloc(u8, 1);
+    try testing.expectError(error.OutOfMemory, alloc.realloc(bytes, page_size + 1));
+    try testing.expectEqual(page_size, budget.stats().used);
+    try testing.expectEqual(Failure.child_out_of_memory, adapter.failureState().last);
+    try testing.expectEqual(@as(usize, 1), adapter.failureState().epoch);
+    try testing.expectEqual(@as(usize, 1), budget.stats().child_failures);
+    alloc.free(bytes);
+    try testing.expectEqual(@as(usize, 0), budget.stats().used);
+}
+
+test "caller budget reference may be freed before adapter" {
+    const testing = std.testing;
+    const budget = try create(testing.allocator, testing.allocator, std.heap.pageSize());
+    const adapter = try Adapter.create(testing.allocator, budget, null);
+    budget.releaseRef();
+    const bytes = try adapter.allocator().alloc(u8, 1);
+    adapter.allocator().free(bytes);
+    adapter.destroy();
+}
+
+test "shared failure sink retains latest cause after adapter destruction" {
+    const testing = std.testing;
+    const budget = try create(testing.allocator, testing.allocator, std.heap.pageSize());
+    defer budget.releaseRef();
+    const sink = try FailureSink.create(testing.allocator);
+    defer sink.releaseRef();
+    const first = try Adapter.create(testing.allocator, budget, sink);
+    defer first.destroy();
+    const derived = try Adapter.create(testing.allocator, budget, sink);
+
+    first.record(.child_out_of_memory);
+    derived.record(.budget_exhausted);
+    derived.destroy();
+    try testing.expectEqual(@as(usize, 2), sink.failureState().epoch);
+    try testing.expectEqual(Failure.budget_exhausted, sink.failureState().last);
