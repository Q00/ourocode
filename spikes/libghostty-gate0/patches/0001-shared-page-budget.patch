+    defer encoded.deinit();
+    try encode(testing.allocator, &encoded.writer, &source_terminal, test_encode_options);
+
+    const probe = try TerminalPageList.PageBudget.create(
+        testing.allocator,
+        testing.allocator,
+        std.math.maxInt(usize),
+    );
+    defer probe.releaseRef();
+    var probe_source: std.Io.Reader = .fixed(encoded.written());
+    var probe_decoder: Decoder = .init(&probe_source);
+    var probe_result = try probe_decoder.ready(testing.allocator, testing.io, .{
+        .max_continuation_bytes = 1024,
+        .page_budget = probe,
+    });
+    const ready_bytes = probe.stats().used;
+    probe_result.deinit(testing.allocator);
+
+    const ready_limit = try std.math.mul(usize, ready_bytes, 2);
+    const budget = try TerminalPageList.PageBudget.create(
+        testing.allocator,
+        testing.allocator,
+        ready_limit,
+    );
+    defer budget.releaseRef();
+    var source: std.Io.Reader = .fixed(encoded.written());
+    var decoder: Decoder = .init(&source);
+    var decoded = try decoder.ready(testing.allocator, testing.io, .{
+        .max_continuation_bytes = 1024,
+        .page_budget = budget,
+    });
+    defer decoded.deinit(testing.allocator);
+    const restored = &decoded.terminal.?;
+    var exhausted = false;
+    while (true) {
+        _ = decoder.next(testing.allocator, restored) catch |err| switch (err) {
+            error.OutOfMemory => {
+                exhausted = true;
+                break;
+            },
+            else => return err,
+        } orelse break;
+    }
+    try testing.expect(exhausted);
+    try testing.expect(budget.stats().used <= ready_limit);
+}
