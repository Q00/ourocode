diff --git a/src/terminal/c/page_budget.zig b/src/terminal/c/page_budget.zig
new file mode 100644
index 0000000..ec7b49c
--- /dev/null
+++ b/src/terminal/c/page_budget.zig
@@ -0,0 +1,95 @@
+const std = @import("std");
+const lib = @import("../lib.zig");
+const CAllocator = lib.alloc.Allocator;
+const Result = @import("result.zig").Result;
+const PageList = @import("../PageList.zig");
+const PageBudget = PageList.PageBudget;
+
+/// C: GhosttyPageBudget
+pub const Budget = ?*PageBudget;
+
+/// C: GhosttyPageBudgetFailure
+pub const Failure = enum(c_int) {
+    none = 0,
+    budget_exhausted = 1,
+    child_out_of_memory = 2,
+    invalid_size = 3,
+    _,
+
+    pub fn fromCore(value: PageBudget.Failure) Failure {
+        return switch (value) {
+            .none => .none,
+            .budget_exhausted => .budget_exhausted,
+            .child_out_of_memory => .child_out_of_memory,
+            .invalid_size => .invalid_size,
+        };
+    }
+};
+
+/// C: GhosttyPageBudgetStats
+pub const Stats = extern struct {
+    size: usize = @sizeOf(Stats),
+    limit_bytes: usize,
+    reserved_bytes: usize,
+    peak_reserved_bytes: usize,
+    denial_count: usize,
+    child_failure_count: usize,
+};
+
+pub fn new(
+    allocator_: ?*const CAllocator,
+    result_: ?*Budget,
+    limit_bytes: usize,
+) callconv(lib.calling_conv) Result {
+    const result = result_ orelse return .invalid_value;
+    result.* = null;
+    const owner = lib.alloc.default(allocator_);
+    result.* = PageBudget.create(
+        owner,
+        PageList.pageAllocator(),
+        limit_bytes,
+    ) catch return .out_of_memory;
+    return .success;
+}
+
+pub fn free(budget: Budget) callconv(lib.calling_conv) void {
+    const value = budget orelse return;
+    value.releaseRef();
+}
+
+pub fn getStats(
+    budget: Budget,
+    result_: ?*Stats,
+) callconv(lib.calling_conv) Result {
+    const value = budget orelse return .invalid_value;
+    const result = result_ orelse return .invalid_value;
+    if (result.size < @sizeOf(Stats)) return .invalid_value;
+    const stats = value.stats();
+    result.* = .{
+        .limit_bytes = stats.limit,
+        .reserved_bytes = stats.used,
+        .peak_reserved_bytes = stats.peak,
+        .denial_count = stats.denials,
+        .child_failure_count = stats.child_failures,
+    };
+    return .success;
+}
+
+test "C page budget stats" {
+    const testing = std.testing;
+    const page_size = std.heap.pageSize();
+    const budget = try PageBudget.create(
+        testing.allocator,
+        testing.allocator,
+        page_size,
+    );
+    defer budget.releaseRef();
+    const bytes = try budget.allocator().alloc(u8, 8);
+    defer budget.allocator().free(bytes);
+
+    var stats: Stats = undefined;
+    stats.size = @sizeOf(Stats);
+    try testing.expectEqual(Result.success, getStats(budget, &stats));
+    try testing.expectEqual(page_size, stats.limit_bytes);
+    try testing.expectEqual(page_size, stats.reserved_bytes);
+}
