+
+test "shared rounded cap denial is local and free permits retry" {
+    const testing = std.testing;
+    const budget = try create(testing.allocator, testing.allocator, std.heap.pageSize());
+    defer budget.releaseRef();
+    const first = try Adapter.create(testing.allocator, budget, null);
+    defer first.destroy();
+    const second = try Adapter.create(testing.allocator, budget, null);
+    defer second.destroy();
+
+    const bytes = try first.allocator().alloc(u8, 1);
+    try testing.expectError(error.OutOfMemory, second.allocator().alloc(u8, 1));
+    try testing.expectEqual(@as(usize, 0), first.failureState().epoch);
+    try testing.expectEqual(Failure.budget_exhausted, second.failureState().last);
+    first.allocator().free(bytes);
+    const retried = try second.allocator().alloc(u8, 1);
+    second.allocator().free(retried);
+}
+
+test "concurrent rounded reservations never exceed cap" {
+    const testing = std.testing;
+    const Worker = struct {
+        adapter: *Adapter,
+        ready: *std.atomic.Value(usize),
+        successes: *std.atomic.Value(usize),
+        release: *std.atomic.Value(bool),
+
+        fn run(self: @This()) void {
+            const bytes = self.adapter.allocator().alloc(u8, 1) catch {
+                _ = self.ready.fetchAdd(1, .release);
+                return;
+            };
+            _ = self.successes.fetchAdd(1, .acq_rel);
+            _ = self.ready.fetchAdd(1, .release);
+            while (!self.release.load(.acquire)) std.atomic.spinLoopHint();
+            self.adapter.allocator().free(bytes);
+        }
+    };
+
+    const page_size = std.heap.pageSize();
+    const budget = try create(testing.allocator, testing.allocator, page_size * 2);
+    defer budget.releaseRef();
+    const adapter = try Adapter.create(testing.allocator, budget, null);
+    defer adapter.destroy();
+    var ready: std.atomic.Value(usize) = .init(0);
+    var successes: std.atomic.Value(usize) = .init(0);
+    var release_workers: std.atomic.Value(bool) = .init(false);
+    var threads: [8]std.Thread = undefined;
+    for (&threads) |*thread| thread.* = try std.Thread.spawn(.{}, Worker.run, .{Worker{
+        .adapter = adapter,
+        .ready = &ready,
+        .successes = &successes,
+        .release = &release_workers,
+    }});
+    while (ready.load(.acquire) != threads.len) std.atomic.spinLoopHint();
+    try testing.expectEqual(@as(usize, 2), successes.load(.acquire));
+    try testing.expect(budget.stats().peak <= budget.stats().limit);
+    release_workers.store(true, .release);
+    for (&threads) |*thread| thread.join();
+    try testing.expectEqual(@as(usize, 0), budget.stats().used);
+}
